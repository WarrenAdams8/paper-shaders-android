// @varyings v_objectUV v_responsiveUV v_responsiveBoxGivenSize v_imageUV
uniform float u_shape;
uniform float u_isImage;
uniform float u_time;
uniform vec4 u_colors[6];
uniform float u_colorsCount;
uniform vec4 u_colorBack;
uniform vec4 u_colorInner;
uniform float u_innerDistortion;
uniform float u_outerDistortion;
uniform float u_outerGlow;
uniform float u_innerGlow;
uniform float u_offset;
uniform float u_angle;
uniform float u_size;
const float TWO_PI = 6.28318530718;
const float PI = 3.14159265358979323846;
vec2 rotate(vec2 uv, float th) {
  return mat2(cos(th), sin(th), -sin(th), cos(th)) * uv;
}
// 9x9 Gaussian blur on R and G channels
// AGSL: no sampler parameters, textureSize() or array constructors. Samples u_image directly;
// binom8() reproduces the upstream kernel {1, 8, 28, 56, 70, 56, 28, 8, 1} (sum 256, 2D norm 65536).
float binom8(int i) {
  int a = i < 0 ? -i : i;
  if (a == 0) return 70.;
  if (a == 1) return 56.;
  if (a == 2) return 28.;
  if (a == 3) return 8.;
  return 1.;
}
vec2 gaussBlur9x9RG(vec2 uv, float radius) {
  vec2 texel = 1.0 / u_imageSize;
  vec2 r = max(radius, 0.0) * texel;
  vec2 sum = vec2(0.0);
  for (int j = -4; j <= 4; ++j) {
    float wy = binom8(j);
    for (int i = -4; i <= 4; ++i) {
      float w = binom8(i) * wy;
      vec2 off = vec2(float(i) * r.x, float(j) * r.y);
      sum += w * paper_image(uv + off).rg;
    }
  }
  return sum / 65536.0;
}
float sst(float a, float b, float x) {
  return smoothstep(a, b, x);
}
// The non-image shape `edge` from main(), factored out so it can be re-evaluated at neighbour
// pixels (AGSL has no fwidth()).
float gemEdge(float2 fragCoord, float time) {
  vec2 v_objectUV = paper_objectUV(fragCoord);
  vec2 v_responsiveUV = paper_responsiveUV(fragCoord);
  vec2 v_responsiveBoxGivenSize = paper_responsiveBoxGivenSize(fragCoord);
    vec2 uv = v_objectUV + .5;
    uv.y = 1. - uv.y;
    float edge = 0.;
    if (u_shape < 1.) {
      // full-fill on canvas
      vec2 borderUV = v_responsiveUV + .5;
      vec2 mask = min(borderUV, 1. - borderUV);
      vec2 pixel_thickness = min(250. / v_responsiveBoxGivenSize, vec2(.5));
      float maskX = smoothstep(0.0, pixel_thickness.x, mask.x);
      float maskY = smoothstep(0.0, pixel_thickness.y, mask.y);
      maskX = pow(maskX, .25);
      maskY = pow(maskY, .25);
      edge = clamp(1. - maskX * maskY, 0., 1.);
    } else if (u_shape < 2.) {
      // circle
      vec2 shapeUV = uv - .5;
      shapeUV *= .67;
      edge = pow(clamp(3. * length(shapeUV), 0., 1.), 18.);
    } else if (u_shape < 3.) {
      // daisy
      vec2 shapeUV = uv - .5;
      shapeUV *= 1.68;
      float r = length(shapeUV) * 2.;
      float a = atan(shapeUV.y, shapeUV.x) + .2;
      r *= (1. + .05 * sin(3. * a + 2. * time));
      float f = abs(cos(a * 3.));
      edge = smoothstep(f, f + .7, r);
      edge *= edge;
    } else if (u_shape < 4.) {
      // diamond
      vec2 shapeUV = uv - .5;
      shapeUV = rotate(shapeUV, .25 * PI);
      shapeUV *= 1.42;
      shapeUV += .5;
      vec2 mask = min(shapeUV, 1. - shapeUV);
      vec2 pixel_thickness = vec2(.15);
      float maskX = smoothstep(0.0, pixel_thickness.x, mask.x);
      float maskY = smoothstep(0.0, pixel_thickness.y, mask.y);
      maskX = pow(maskX, .25);
      maskY = pow(maskY, .25);
      edge = clamp(1. - maskX * maskY, 0., 1.);
    } else if (u_shape < 5.) {
      // metaballs
      vec2 shapeUV = uv - .5;
      shapeUV *= 1.3;
      edge = 0.;
      for (int i = 0; i < 5; i++) {
        float fi = float(i);
        float speed = 1.5 + 2./3. * sin(fi * 12.345);
        float angle = -fi * 1.5;
        vec2 dir1 = vec2(cos(angle), sin(angle));
        vec2 dir2 = vec2(cos(angle + 1.57), sin(angle + 1.));
        vec2 traj = .4 * (dir1 * sin(time * speed + fi * 1.23) + dir2 * cos(time * (speed * 0.7) + fi * 2.17));
        float d = length(shapeUV + traj);
        edge += pow(1.0 - clamp(d, 0.0, 1.0), 4.0);
      }
      edge = 1. - smoothstep(.65, .9, edge);
      edge = pow(edge, 4.);
    }
  return edge;
}

half4 main(float2 fragCoord) {
  float2 fragCoordGL = float2(fragCoord.x, u_resolution.y - fragCoord.y);
  vec4 fragColor = vec4(0.);
  vec2 v_objectUV = paper_objectUV(fragCoord);
  vec2 v_responsiveUV = paper_responsiveUV(fragCoord);
  vec2 v_responsiveBoxGivenSize = paper_responsiveBoxGivenSize(fragCoord);
  vec2 v_imageUV = paper_imageUV(fragCoord);
  float time = u_time;
  float roundness = 0.;
  float imgAlpha = 0.;
  if (u_isImage > .5) {
    // Image sampling (UV scaled inward to account for padding)
    vec2 imageUV = v_imageUV;
    imageUV -= .5;
    imageUV *= .95;
    imageUV += .5;
    // Blurred image: x = roundness, y = alpha
    vec2 blurred = gaussBlur9x9RG(imageUV, 10.);
    roundness = 1. - blurred.x;
    vec2 texelA = 1.0 / u_imageSize;
    for (int j = -1; j <= 1; ++j) {
      for (int i = -1; i <= 1; ++i) {
        imgAlpha += (2. - abs(float(i))) * (2. - abs(float(j))) * paper_image( imageUV + vec2(float(i) * texelA.x, float(j) * texelA.y)).g;
      }
    }
    imgAlpha /= 16.0;
  } else {
    vec2 uv = v_objectUV + .5;
    uv.y = 1. - uv.y;
    float edge = 0.;
    if (u_shape < 1.) {
      // full-fill on canvas
      vec2 borderUV = v_responsiveUV + .5;
      vec2 mask = min(borderUV, 1. - borderUV);
      vec2 pixel_thickness = min(250. / v_responsiveBoxGivenSize, vec2(.5));
      float maskX = smoothstep(0.0, pixel_thickness.x, mask.x);
      float maskY = smoothstep(0.0, pixel_thickness.y, mask.y);
      maskX = pow(maskX, .25);
      maskY = pow(maskY, .25);
      edge = clamp(1. - maskX * maskY, 0., 1.);
    } else if (u_shape < 2.) {
      // circle
      vec2 shapeUV = uv - .5;
      shapeUV *= .67;
      edge = pow(clamp(3. * length(shapeUV), 0., 1.), 18.);
    } else if (u_shape < 3.) {
      // daisy
      vec2 shapeUV = uv - .5;
      shapeUV *= 1.68;
      float r = length(shapeUV) * 2.;
      float a = atan(shapeUV.y, shapeUV.x) + .2;
      r *= (1. + .05 * sin(3. * a + 2. * time));
      float f = abs(cos(a * 3.));
      edge = smoothstep(f, f + .7, r);
      edge *= edge;
    } else if (u_shape < 4.) {
      // diamond
      vec2 shapeUV = uv - .5;
      shapeUV = rotate(shapeUV, .25 * PI);
      shapeUV *= 1.42;
      shapeUV += .5;
      vec2 mask = min(shapeUV, 1. - shapeUV);
      vec2 pixel_thickness = vec2(.15);
      float maskX = smoothstep(0.0, pixel_thickness.x, mask.x);
      float maskY = smoothstep(0.0, pixel_thickness.y, mask.y);
      maskX = pow(maskX, .25);
      maskY = pow(maskY, .25);
      edge = clamp(1. - maskX * maskY, 0., 1.);
    } else if (u_shape < 5.) {
      // metaballs
      vec2 shapeUV = uv - .5;
      shapeUV *= 1.3;
      edge = 0.;
      for (int i = 0; i < 5; i++) {
        float fi = float(i);
        float speed = 1.5 + 2./3. * sin(fi * 12.345);
        float angle = -fi * 1.5;
        vec2 dir1 = vec2(cos(angle), sin(angle));
        vec2 dir2 = vec2(cos(angle + 1.57), sin(angle + 1.));
        vec2 traj = .4 * (dir1 * sin(time * speed + fi * 1.23) + dir2 * cos(time * (speed * 0.7) + fi * 2.17));
        float d = length(shapeUV + traj);
        edge += pow(1.0 - clamp(d, 0.0, 1.0), 4.0);
      }
      edge = 1. - smoothstep(.65, .9, edge);
      edge = pow(edge, 4.);
    }
    float fwEdge = abs(gemEdge(fragCoord + vec2(1., 0.), time) - edge) + abs(gemEdge(fragCoord + vec2(0., 1.), time) - edge);
    imgAlpha = 1. - smoothstep(.9 - 2. * fwEdge, .9, edge);
    roundness = 1. - edge;
  }
// Smoke UV setup
  vec2 smokeUV = v_objectUV;
  smokeUV = rotate(smokeUV, u_angle * PI / 180.);
  smokeUV *= mix(4., 1., u_size);
  // Two swirl paths: inner (shape-masked) and outer (free), each with independent distortion.
  // AGSL has no dFdx()/dFdy(). The swirl below needs d(innerUV)/d(screen) and d(outerUV)/d(screen),
  // so their screen derivatives are carried along analytically (forward-mode differentiation).
  // The roundness term is treated as locally constant (it comes from a blurred map).
  vec2 sDx = rotate(vec2(u_objectUVx.x, u_objectUVy.x), u_angle * PI / 180.) * mix(4., 1., u_size);
  vec2 sDy = rotate(vec2(u_objectUVx.y, u_objectUVy.y), u_angle * PI / 180.) * mix(4., 1., u_size);
  vec2 innerUV = smokeUV;
  vec2 outerUV = smokeUV;
  vec2 inDx = sDx;
  vec2 inDy = sDy;
  vec2 outDx = sDx;
  vec2 outDy = sDy;
  {
    float L = length(.4 * smokeUV);
    vec2 dLdUV = .4 * smokeUV / max(length(smokeUV), 1e-6);
    float dSst = (L < 1.) ? 6. * L * (1. - L) : 0.;
    inDx.y += -u_innerDistortion * dSst * dot(dLdUV, sDx);
    inDy.y += -u_innerDistortion * dSst * dot(dLdUV, sDy);
    outDx.y += -u_outerDistortion * dSst * dot(dLdUV, sDx);
    outDy.y += -u_outerDistortion * dSst * dot(dLdUV, sDy);
  }
  // Vertical displacement, applied independently to inner and outer.
  innerUV.y += u_innerDistortion * (1. - sst(0., 1., length(.4 * innerUV)));
  innerUV.y -= .4 * u_innerDistortion;
  innerUV.y += .7 * u_offset * roundness;
  outerUV.y += u_outerDistortion * (1. - sst(0., 1., length(.4 * outerUV)));
  outerUV.y -= .4 * u_outerDistortion;
  float innerSwirl = u_innerDistortion * roundness;
  float outerSwirl = u_outerDistortion;
  for (int i = 1; i < 5; i++) {
    float fi = float(i);
    float stretchIn = max(length(inDx), length(inDy));
    float dampenIn = 1. / (1. + stretchIn * 8.);
    float sIn = innerSwirl * dampenIn;
    float kx = -sIn * 2.9 * sin(time + fi * 2.9 * innerUV.y);
    innerUV.x += sIn / fi * cos(time + fi * 2.9 * innerUV.y);
    inDx.x += kx * inDx.y;
    inDy.x += kx * inDy.y;
    float ky = -sIn * 1.5 * sin(time + fi * 1.5 * innerUV.x);
    innerUV.y += sIn / fi * cos(time + fi * 1.5 * innerUV.x);
    inDx.y += ky * inDx.x;
    inDy.y += ky * inDy.x;
    float stretchOut = max(length(outDx), length(outDy));
    float dampenOut = 1. / (1. + stretchOut * 8.);
    float sOut = outerSwirl * dampenOut;
    kx = -sOut * 2.9 * sin(time + fi * 2.9 * outerUV.y);
    outerUV.x += sOut / fi * cos(time + fi * 2.9 * outerUV.y);
    outDx.x += kx * outDx.y;
    outDy.x += kx * outDy.y;
    ky = -sOut * 1.5 * sin(time + fi * 1.5 * outerUV.x);
    outerUV.y += sOut / fi * cos(time + fi * 1.5 * outerUV.x);
    outDx.y += ky * outDx.x;
    outDy.y += ky * outDy.x;
  }
  // Smoke shapes from swirl fields
  float innerShape = exp(-1.5 * dot(innerUV, innerUV));
  float outerShape = exp(-1.5 * dot(outerUV, outerUV));
  // Visibility masks
  float outerMask = pow(u_outerGlow, 2.) * (1. - imgAlpha);
  float innerMask = (.01 + .99 * u_innerGlow) * imgAlpha;
  innerShape *= innerMask;
  outerShape *= outerMask;
  // Color gradient
  float mixer = (innerShape + outerShape) * u_colorsCount;
  vec4 gradient = u_colors[0];
  gradient.rgb *= gradient.a;
  float smokeMask = 0.;
  for (int i = 1; i < 11; i++) {
    if (i > int(u_colorsCount)) break;
    float m = sst(0., 1., clamp(mixer - float(i - 1), 0., 1.));
    if (i == 1) smokeMask = m;
    vec4 c = u_colors[i - 1];
    c.rgb *= c.a;
    gradient = mix(gradient, c, m);
  }
  // Compositing (premultiplied alpha, front-to-back)
  vec3 color = gradient.rgb * smokeMask;
  float opacity = gradient.a * smokeMask;
  float innerOpacity = u_colorInner.a * imgAlpha;
  vec3 innerColor = u_colorInner.rgb * innerOpacity;
  color += innerColor * (1.0 - opacity);
  opacity += innerOpacity * (1.0 - opacity);
  vec3 backColor = u_colorBack.rgb * u_colorBack.a;
  color += backColor * (1.0 - opacity);
  opacity += u_colorBack.a * (1.0 - opacity);
  fragColor = vec4(color, opacity);
  return half4(fragColor);
}
