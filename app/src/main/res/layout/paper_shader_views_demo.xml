<?xml version="1.0" encoding="utf-8"?>
<!-- Classic-View usage of PaperShaderView: the shader is picked by id from XML. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.paperdesign.shaders.view.PaperShaderView
        android:id="@+id/view_mesh"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:contentDescription="@string/demo_mesh_gradient"
        app:shader="mesh-gradient" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.paperdesign.shaders.view.PaperShaderView
            android:id="@+id/view_dot_orbit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/demo_dot_orbit"
            app:shader="dot-orbit" />

        <com.paperdesign.shaders.view.PaperShaderView
            android:id="@+id/view_halftone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:contentDescription="@string/demo_halftone"
            app:shader="halftone-dots" />
    </LinearLayout>
</LinearLayout>
