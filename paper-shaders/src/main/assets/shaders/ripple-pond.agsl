// Ripple Pond: an original interactive shader (not from paper-design/shaders).
// Tap to drop ripples, hold to keep stirring, tilt the phone to move the light.
// A height field (ambient swell + expanding rings from the last 8 taps) is shaded as water:
// a depth gradient, a refracted caustic pattern and a specular glint.
uniform float u_time;
uniform vec4 u_colorDeep;
uniform vec4 u_colorShallow;
uniform vec4 u_colorHighlight;
uniform float u_rippleSize;
uniform float u_rippleSpeed;
uniform float u_damping;
uniform float u_swell;
uniform float u_caustics;
uniform float u_glint;

const float TWO_PI = 6.28318530718;

// Ring wave from one tap: a wave packet travelling outwards that fades with age and distance.
float ring(vec2 uv, vec2 center, float age, float k) {
  float d = length(uv - center);
  float front = age * (.15 + .5 * u_rippleSpeed);
  float x = (d - front) * 5.;
  float packet = exp(-x * x); // not pow(): pow of a negative base is undefined
  float fade = exp(-age * (.15 + 1.2 * u_damping)) / (1. + 1.5 * d);
  return sin((d - front) * k) * packet * fade;
}

float height(vec2 uv, float t) {
  float k = mix(80., 18., u_rippleSize);
  // Ambient swell: a few crossing waves.
  float h = u_swell * .08 * (
    sin(dot(uv, vec2(3.1, 1.7)) * 2. + t * .9) +
    sin(dot(uv, vec2(-2.3, 2.9)) * 2.3 - t * 1.1) +
    .5 * sin(dot(uv, vec2(5.3, -4.1)) * 2. + t * 1.7));
  for (int i = 0; i < 8; i++) {
    vec4 tap = u_touches[i];
    h += tap.w * 1.6 * ring(uv, paper_objectUV(tap.xy), tap.z, k);
  }
  // Holding a finger down keeps a small source oscillating under it.
  if (u_pointer.z > .5) {
    float d = length(uv - paper_objectUV(u_pointer.xy));
    h += .4 * sin(d * k - t * 9.) * exp(-d * 6.);
  }
  return h;
}

// Cheap caustic web: sum of folded sines.
float caustic(vec2 p, float t) {
  float c = 0.;
  for (int i = 0; i < 3; i++) {
    float fi = float(i);
    p = vec2(p.x * .8 - p.y * .6, p.x * .6 + p.y * .8) * 1.7 + fi * 1.3;
    c += abs(sin(p.x + t * (.6 + .2 * fi)) + sin(p.y - t * (.5 + .15 * fi)));
  }
  return pow(clamp(1. - c / 4.5, 0., 1.), 3.);
}

half4 main(float2 fragCoord) {
  vec2 uv = paper_objectUV(fragCoord);
  float t = u_time;

  // Height-field normal from central differences (in object UV units, ~1.5 px apart).
  float e = 1.5 * u_objectPx;
  float h = height(uv, t);
  float hx = height(uv + vec2(e, 0.), t);
  float hy = height(uv + vec2(0., e), t);
  vec3 n = normalize(vec3(-(hx - h) / e * .015, -(hy - h) / e * .015, 1.));

  // Light comes from "above" the screen; tilting the phone swings it around.
  vec3 light = normalize(vec3(-u_tilt.x * 1.5 - .4, u_tilt.y * 1.5 + .6, 1.));
  vec3 view = vec3(0., 0., 1.);

  float depth = clamp(.55 + .5 * length(uv) - 2.5 * h, 0., 1.);
  vec4 deep = u_colorDeep;
  vec4 shallow = u_colorShallow;
  vec3 color = mix(shallow.rgb * shallow.a, deep.rgb * deep.a, depth);
  float opacity = mix(shallow.a, deep.a, depth);

  float c = caustic(uv * 6. + n.xy * 3., t);
  color += u_caustics * .6 * c * shallow.rgb;

  float diffuse = .75 + .25 * dot(n, light);
  color *= diffuse;

  vec3 r = reflect(-light, n);
  float spec = pow(max(dot(r, view), 0.), 60.) * u_glint;
  vec4 hl = u_colorHighlight;
  color = mix(color, hl.rgb, clamp(spec * hl.a, 0., 1.));
  opacity = max(opacity, clamp(spec * hl.a, 0., 1.));

  color += 1. / 256. * (fract(sin(dot(.014 * fragCoord, vec2(12.9898, 78.233))) * 43758.5453123) - .5);
  return half4(color * 1., opacity);
}
