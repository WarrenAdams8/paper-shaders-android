// @varyings v_objectUV


uniform float u_time;


uniform vec4 u_colorBack;
uniform vec4 u_colors[8];
uniform float u_colorsCount;
uniform float u_size;
uniform float u_count;




const float TWO_PI = 6.28318530718;
const float PI = 3.14159265358979323846;


  float randomR(vec2 p) {
    vec2 uv = floor(p) / 100. + .5;
    return paper_noise( fract(uv)).r;
  }

float noise(float x) {
  float i = floor(x);
  float f = fract(x);
  float u = f * f * (3.0 - 2.0 * f);
  vec2 p0 = vec2(i, 0.0);
  vec2 p1 = vec2(i + 1.0, 0.0);
  return mix(randomR(p0), randomR(p1), u);
}

float getBallShape(vec2 uv, vec2 c, float p) {
  float s = .5 * length(uv - c);
  s = 1. - clamp(s, 0., 1.);
  s = pow(s, p);
  return s;
}

half4 main(float2 fragCoord) {
  float2 fragCoordGL = float2(fragCoord.x, u_resolution.y - fragCoord.y);
  vec4 fragColor = vec4(0.);
  vec2 v_objectUV = paper_objectUV(fragCoord);
  vec2 shape_uv = v_objectUV;

  shape_uv += .5;

  const float firstFrameOffset = 2503.4;
  float t = .2 * (u_time + firstFrameOffset);

  vec3 totalColor = vec3(0.);
  float totalShape = 0.;
  float totalOpacity = 0.;
  vec2 totalGrad = vec2(0.);

  for (int i = 0; i < 20; i++) {
    if (i >= int(ceil(u_count))) break;

    float idxFract = float(i) / float(20);
    float angle = TWO_PI * idxFract;

    float speed = 1. - .2 * idxFract;
    float noiseX = noise(angle * 10. + float(i) + t * speed);
    float noiseY = noise(angle * 20. + float(i) - t * speed);

    vec2 pos = vec2(.5) + 1e-4 + .9 * (vec2(noiseX, noiseY) - .5);

    // AGSL: no integer '%' and no dynamic array indexing.
    float safeIndex = mod(float(i), floor(u_colorsCount + 0.5));
    vec4 ballColor = u_colors[0];
    for (int j = 1; j < 8; j++) {
      if (float(j) == safeIndex) ballColor = u_colors[j];
    }
    ballColor.rgb *= ballColor.a;

    float sizeFrac = 1.;
    if (float(i) > floor(u_count - 1.)) {
      sizeFrac *= fract(u_count);
    }

    float power = 45. - 30. * u_size * sizeFrac;
    float shape = getBallShape(shape_uv, pos, power);
    float sizeK = pow(u_size, .2);
    shape *= sizeK;
    // Analytic gradient of smoothstep(sizeK * (1 - .5|uv - pos|)^power), for the fwidth() below.
    vec2 toBall = shape_uv - pos;
    float r = length(toBall);
    float base = 1. - clamp(.5 * r, 0., 1.);
    float dsdr = -sizeK * power * .5 * pow(max(base, 1e-6), power - 1.) * step(.5 * r, 1.);
    float sClamped = clamp(shape, 0., 1.);
    totalGrad += 6. * sClamped * (1. - sClamped) * dsdr * toBall / max(r, 1e-6);
    shape = smoothstep(0., 1., shape);

    totalColor += ballColor.rgb * shape;
    totalShape += shape;
    totalOpacity += ballColor.a * shape;
  }

  totalColor /= max(totalShape, 1e-4);
  totalOpacity /= max(totalShape, 1e-4);

  // AGSL has no fwidth(): use the analytic gradient (object UV units) times the pixel size.
  float edge_width = (abs(totalGrad.x) + abs(totalGrad.y)) * u_objectPx;
  float finalShape = smoothstep(.4, .4 + edge_width, totalShape);

  vec3 color = totalColor * finalShape;
  float opacity = totalOpacity * finalShape;

  vec3 bgColor = u_colorBack.rgb * u_colorBack.a;
  color = color + bgColor * (1. - opacity);
  opacity = opacity + u_colorBack.a * (1. - opacity);

  
  color += 1. / 256. * (fract(sin(dot(.014 * fragCoordGL.xy, vec2(12.9898, 78.233))) * 43758.5453123) - .5);


  fragColor = vec4(color, opacity);
  return half4(fragColor);
}

